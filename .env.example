NODE_ENV=development
PORT=3000

# Docker Compose：宿主机映射端口（默认 3000）。改端口时请同步修改 PUBLIC_BASE_URL
# HOST_PORT=3000

# 对外访问根地址（生成 /storage/... 链接，勿带末尾 /）
PUBLIC_BASE_URL=http://127.0.0.1:3000

# CORS：* 表示反射请求 Origin；多个域名用英文逗号分隔
CORS_ORIGIN=*

# 是否挂载 /storage 静态目录（生产可改为 false，改用 CDN/对象存储）
SERVE_STORAGE=true

# 并发处理视频任务数上限（单机 ffmpeg 建议 1–4）
MAX_CONCURRENT_VIDEO_JOBS=2

# yt-dlp 下载超时（毫秒）
DOWNLOAD_TIMEOUT_MS=600000

# ffmpeg / 分镜脚本超时（毫秒）
FFMPEG_TIMEOUT_MS=3600000

# Python 可执行文件（分镜脚本）
# PYTHON_BIN=/path/to/python/venv/bin/python
